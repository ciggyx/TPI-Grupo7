@startuml Parte_Estática_CU_23_State_Parte1
left to right direction
hide <<Entity>> circle
hide <<Boundary>> circle
hide <<Control>> circle
hide <<State>> circle
hide <<Abstract>> circle

class GestorRegistrarRevisión<<Control>>{
    - fechaHoraOcurrencia: DateTime
    - latitudEpicentro: Float
    - longitudEpicentro: Float
    - latidudHipocentro: Float
    - longitudHipocentro: Float
    - listaEventoSísmicoSinRevisión: EventoSismico[]
    - eventoSísmicoSeleccionado: EventoSismico
    - fechaHoraActual: DateTime
    - ASLogueado: Empleado
    + 20. bloquearEventoSismico(): void
    + 21. getFechaHoraActual(): DateTime
    + 22. buscarEmpleadoLogueado(): Empleado
}

class Sesion<<Entity>>{
    - fechaHoraInicio: DateTime
    - fechaHoraFin: DateTime
    + 23. getUsuarioLogueado(): Empleado
}

class Usuario<<Entity>>{
    - nombreUsuario: String
    - contraseña: String
    + 24. getEmpleado(): Empleado
}

class EventoSismico<<Entity>>{
    - fechaHoraOcurrencia: DateTime
    - latitudEpicentro: Float
    - longitudEpicentro: Float
    - latidudHipocentro: Float
    - longitudHipocentro: Float
    - valorMagnitud: Float 
    + 28. bloquear(fechaHora: Datetime, empleado: Empleado) : void
    + 34. setEstado(estado: Estado) : void
    + 35. agregarCambioEstado(cambioEstado: CambioEstado) : void
    + revisar(): void
    + derivar(): void
    + confirmarDerivado(): void
    + confirmarDirecto(): void
    + pendienteCerrar(): void
    + cerrar(): void
}

class Estado<<Abstract>>{
    - ámbito: String
    - nombre: String
    ' Preguntar AutoDetectado y AutoConfirmado
    ' que arrancan con el new()
    + rechazar() : Rechazado
    ' Preguntar estos dos pases
    + bloquear() : Bloqueado
    + bloquear() : EventoSinRevisión
    ' Preguntar estos dos pases
    + revisar() : PendienteRevision
    + revisar() : BloqueadoRevision
    + derivar() : DerivadoExperto
    + confirmarDerivado() : Confirmado
    + confirmarDirecto() : Confirmado
    + pendienteCerrar() : PendienteCierre
    + cerrar() : Cerrado
}

class PendienteRevision<<State>>{
    + revisar() : PendienteRevision
    + 26.bloquear(fechaHora: Datetime, empleado: Empleado,\n cambiosEstado: CambioEstado[],\n this: EventoSísmico) : BloqueadoRevisión
    + 27.cerrarCambioEstado() : void
    + 30.crearBloqueadoRevisión() : void
    + 32.crearCambioEstado() : CambioEstado
}

class CambioEstado<<Entity>>{
    - fechaHoraInicio: DateTime
    - fechaHoraFin: DateTime
    - empleado: Empleado
    + 28. esEstadoActual(): boolean
    + 30. setFechaHoraFin(fechaHora: Datetime, empleado: Empleado) : void
    + 33. new(fechaHora: Datetime, estado: Estado, empleado: Empleado) : CambioEstado
}
class AutoDetectado<<State>>{
    + new() : AutoDetectado
}

class AutoConfirmado<<State>>{
    + new() : AutoConfirmado
}

class BloqueadoRevisión<<State>>{
    + revisar() : BloqueadoRevisión
    + bloquear() : BloqueadoRevisión
    + rechazar(fechaHora: Datetime, empleado: Empleado,\n cambiosEstado: CambioEstado,\n this: EventoSísmico) : Rechazado
    + cerrarCambioEstado() : void
    + crearEstadoRechazado() : void
    + crearCambioEstado() : void
}

class EventoSinRevisión<<State>>{
    + bloquear() : EventoSinRevisión
}

class DerivadoExperto<<State>>{
    + derivar() : DerivadoExperto
}

class Rechazado<<State>>{
    + rechazar() : Rechazado
}

class Confirmado<<State>>{
    + confirmarDerivado() : Confirmado
}

class PendienteCierre<<State>>{
    + pendienteCerrar() : PendienteCierre
}

class Cerrado<<State>>{
    + cerrar() : Cerrado
}

GestorRegistrarRevisión ..> EventoSismico
EventoSismico "estado" --> "1" Estado
Sesion --> Usuario
GestorRegistrarRevisión .left.> Sesion
EventoSismico "cambioEstado" -down-> "1..*" CambioEstado
CambioEstado "estado" --> "1" Estado
AutoDetectado ..|> Estado
AutoConfirmado .left.|> Estado
PendienteRevision .down.|> Estado
PendienteRevision ..> BloqueadoRevisión
Estado <|.. BloqueadoRevisión
Estado <|.. EventoSinRevisión
Estado <|.. DerivadoExperto
Estado <|.. Rechazado
Estado <|.. Confirmado
Estado <|.. PendienteCierre
Estado <|.. Cerrado
EventoSismico ..>PendienteRevision
EventoSismico <..PendienteRevision
PendienteRevision..>CambioEstado
@enduml
