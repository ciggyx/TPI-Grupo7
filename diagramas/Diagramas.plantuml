AES -> PRR : tomarModificaciónDatosES()
PRR -> GRR : tomarModificaciónDatosES()
GRR -> PRR : solicitarAcciónSobreEvento()
AES -> PRR : tomarAcciónSobreEvento()
PRR -> GRR : tomarAcciónSobreEvento()
GRR -> GRR : validarDatos()
GRR -> GRR : rechazarEventoSísmico() : void
GRR -> GRR : getFechaHoraActual() : Datetime
entity "__Selec:EventoSísmico__" as SES
GRR -> SES : rechazar(fechaHora: Datetime, empleado: Empleado) : Rechazado
participant "__BloqueadoRevisión__" as BER
SES -> BER : rechazar(fechaHora: Datetime, empleado: Empleado, cambiosEstado: CambioEstado[], this: EventoSísmico) : Rechazado
BER -> BER : cerrarCambioEstado() : void
loop Buscar último cambio estado
else Mientras existan cambios de estado
    BER -> CE : esEstadoActual() : boolean
end
BER -> NCE : setFechaHoraFin(fechaHora: Datetime, empleado: Empleado) : void
BER -> BER : crearEstadoRechazado() : void
create participant "__:Rechazado__" as R
BER --> R : rechazar() : Rechazado
BER -> BER: crearCambioEstado() : void
create entity "__Rechazado:CambioEstado__" as RCE
BER --> RCE : new(fechaHora: Datetime, estado: Estado) : CambioEstado
BER -> SES : setEstado(estado: Estado) : void
BER -> SES : agregarCambioEstado(cambioEstad: CambioEstado) : void
destroy BER
GRR -> GRR : finCU()
@enduml